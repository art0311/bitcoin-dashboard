name: BTC ETH Forecast - Pipeline Preflight

# One-time integration test on the development branch.
# This only runs when THIS workflow file is committed or changed.
# It is deliberately NOT scheduled.
on:
  push:
    branches:
      - feature/coinglass-api
    paths:
      - '.github/workflows/forecast-pipeline-preflight.yml'

permissions:
  contents: read

concurrency:
  group: crypto-forecast-pipeline-preflight
  cancel-in-progress: false

jobs:
  pipeline-preflight:
    name: Confirm forecast idempotency and evaluation readiness
    runs-on: ubuntu-latest
    timeout-minutes: 20

    steps:
      - name: Check out development branch
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install dependencies
        run: python -m pip install pandas numpy scikit-learn yfinance

      - name: Check Python syntax
        run: python -m py_compile daily_forecast_job.py forecast_backtest.py forecast_storage.py evaluate_forecasts.py

      - name: Confirm Supabase secrets exist
        env:
          SUPABASE_URL: ${{ secrets.SUPABASE_URL }}
          SUPABASE_KEY: ${{ secrets.SUPABASE_KEY }}
        run: |
          test -n "$SUPABASE_URL" || { echo 'Missing SUPABASE_URL'; exit 1; }
          test -n "$SUPABASE_KEY" || { echo 'Missing SUPABASE_KEY'; exit 1; }
          echo 'Both Supabase secrets are set.'

      # The first 32 forecasts were already saved. This tests whether the
      # same-day job recognizes existing rows instead of saving new duplicates.
      - name: Check repeat forecast saving
        env:
          SUPABASE_URL: ${{ secrets.SUPABASE_URL }}
          SUPABASE_KEY: ${{ secrets.SUPABASE_KEY }}
        run: python daily_forecast_job.py --asset both --save

      # Do NOT write outcomes until we have verified a matured forecast.
      - name: Check matured forecasts without updating Supabase
        env:
          SUPABASE_URL: ${{ secrets.SUPABASE_URL }}
          SUPABASE_KEY: ${{ secrets.SUPABASE_KEY }}
        run: python evaluate_forecasts.py
